/* Variables CSS Globales */
:root {
    --color-primario: #1a1a2e;
    --color-secundario: #16213e;
    --color-acento: #fce205;
    --color-texto: #f1f1f1;
    --fuente-principal: 'Segoe UI', Arial, sans-serif;
}

/* --------------------------------------
   Comportamiento de Scroll Global
--------------------------------------- */
html {
    scroll-padding-top: 85px; 
    scroll-behavior: smooth; 
}

body {
    font-family: var(--fuente-principal);
    background-color: #fafafa;
}

/* --------------------------------------
   Accesibilidad (Navegación por Teclado)
--------------------------------------- */
/* Destaca los elementos interactivos al navegar con la tecla Tab */
.nav-link:focus-visible,
.btn-custom:focus-visible,
.navbar-brand:focus-visible,
a:focus-visible {
    outline: 3px solid var(--color-acento) !important;
    outline-offset: 4px;
    border-radius: 4px;
}

/* --------------------------------------
   Navbar y Navegación
--------------------------------------- */
.nav-link {
    transition: color 0.2s ease, border-bottom 0.2s ease;
    border-bottom: 2px solid transparent;
    color: var(--color-texto) !important;
    font-weight: 600;
}

.nav-link:hover, 
.nav-link.active {
    color: var(--color-acento) !important;
    border-bottom: 2px solid var(--color-acento);
}

/* --------------------------------------
   Header Hero y Footer
--------------------------------------- */
.header-bg {
    background-color: var(--color-primario);
    border-bottom: 4px solid var(--color-acento);
}

.footer-bg {
    background-color: var(--color-primario);
    border-top: 4px solid var(--color-acento);
}

/* --------------------------------------
   Carrusel 
--------------------------------------- */
.carousel-img {
    filter: brightness(0.75);
}

.carousel-caption h5 {
    font-weight: bold;
}
/* --------------------------------------
   Tarjetas (Cards)
--------------------------------------- */
.card-img-top {
    height: 220px;
    object-fit: cover;
    border-bottom: 3px solid var(--color-secundario);
}

.producto-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.producto-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15) !important;
    border-bottom: 3px solid var(--color-acento) !important;
}

/* Botón personalizado de tarjetas */
.btn-custom {
    background-color: var(--color-secundario);
    border: 1px solid var(--color-secundario);
    color: var(--color-texto);
    transition: all 0.3s ease;
}

.btn-custom:hover {
    background-color: var(--color-primario);
    border-color: var(--color-acento);
    color: var(--color-acento);
}
